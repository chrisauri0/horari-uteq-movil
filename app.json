{
  "expo": {
    "name": "Horari-UTEQ",
    "slug": "Horari-UTEQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-notificacion.png",
    "scheme": "com.chrisauri0.horariuteq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
  "package": "com.chrisauri0.horariuteq",
      "permissions": ["RECEIVE_BOOT_COMPLETED"],
      "notification": {
        "icon": "./assets/images/logo-notificacion.png",
        "color": "#0050b5"
      },
    
  "adaptiveIcon": {
    "backgroundColor": "#E6F4FE",
    "foregroundImage": "./assets/images/android-icon-foreground.png",
    "backgroundImage": "./assets/images/android-icon-background.png",
    "monochromeImage": "./assets/images/android-icon-monochrome.png"
  },
  "edgeToEdgeEnabled": true,
  "predictiveBackGestureEnabled": false
}
    ,
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [

       [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-notificacion.png",
          "color": "#0050b5"
        }
      ],

      


      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-notificacion.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9547f1e3-630e-454b-b827-1076b9b8cf4e"
      }
    }
    
  }
}
